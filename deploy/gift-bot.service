[Unit]
Description=Gift — Telegram-бот управления торговлей подарками
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=gift
Group=gift
WorkingDirectory=/opt/gift
EnvironmentFile=/opt/gift/.env
ExecStart=/opt/gift/.venv/bin/python -m app.bot.main
Restart=always
RestartSec=10

# Изоляция
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gift
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gift-bot

[Install]
WantedBy=multi-user.target
