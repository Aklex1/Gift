# =====================================================================
#  Gift — торговый бот перепродажи подарков Telegram
#  Скопируйте в .env и заполните. Файл .env в git не попадает.
# =====================================================================

# ---------------------------------------------------------------------
# 1. КЛЮЧ ШИФРОВАНИЯ  (обязательно)
#    Сгенерировать:  gift-cli gen-key
#    Если ключ потерять — сохранённые секреты не расшифруются.
# ---------------------------------------------------------------------
GIFT_SECRET_KEY=

# ---------------------------------------------------------------------
# 2. TELEGRAM-БОТ — интерфейс управления  (обязательно)
#    BOT_TOKEN: у @BotFather -> /newbot -> скопировать токен
#    OWNER_IDS: ваш числовой Telegram id. Узнать: напишите боту /id
#               Несколько владельцев — через запятую.
#               ПУСТОЕ ЗНАЧЕНИЕ = бот не отвечает никому (fail-closed).
# ---------------------------------------------------------------------
BOT_TOKEN=
OWNER_IDS=

# ---------------------------------------------------------------------
# 3. ТОРГОВЫЙ АККАУНТ TELEGRAM — MTProto  (обязательно для поиска)
#    Где взять: https://my.telegram.org -> войти по номеру телефона
#               -> "API development tools" -> создать приложение
#               -> скопировать api_id (число) и api_hash (32 символа)
#
#    ВАЖНО: это ОБЫЧНЫЙ аккаунт Telegram, а не бот. Именно он видит
#    маркет перепродажи подарков и совершает покупки за Stars.
#    Используйте ОТДЕЛЬНЫЙ аккаунт только под торговлю.
#
#    После заполнения выполните на сервере:  gift-cli login
# ---------------------------------------------------------------------
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION_NAME=trading

# ---------------------------------------------------------------------
# 4. ВНЕШНИЕ ПЛОЩАДКИ  (необязательно, только чтение)
#    Публичного API и SLA у них нет — статус "experimental".
#    Покупка через них в коде ЗАКРЫТА намеренно; используются как
#    источник цен для оценки.
#    Токен берётся из заголовка Authorization в DevTools браузера
#    при открытии мини-приложения площадки. Он протухает — это
#    нормально, бот пометит площадку недоступной и продолжит работу.
# ---------------------------------------------------------------------
PORTALS_BASE_URL=https://portals.tg/api
PORTALS_AUTH=

# MRKT: реальный публичный хост (github.com/boostNT/MRKT-API).
# MRKT_INIT_DATA — initData мини-приложения: если он задан, бот сам
# меняет его на токен и обновляет по истечении. Иначе нужен MRKT_AUTH.
MRKT_BASE_URL=https://api.tgmrkt.io/api/v1
MRKT_AUTH=
MRKT_INIT_DATA=

TONNEL_BASE_URL=https://gifts2.tonnel.network/api
TONNEL_AUTH=

# Getgems: публичный API, ключ по запросу на https://api.getgems.io/public-api/docs
GETGEMS_BASE_URL=https://api.getgems.io/public-api
GETGEMS_API_KEY=

# ---------------------------------------------------------------------
# 5. TON  (необязательно, только чтение баланса)
#    Ключ: https://tonconsole.com -> TON API -> создать ключ
#    Приватный ключ кошелька здесь НЕ хранится и не нужен.
# ---------------------------------------------------------------------
TONAPI_BASE_URL=https://tonapi.io
TONAPI_KEY=
TON_WALLET_ADDRESS=

# ---------------------------------------------------------------------
# 6. ТОРГОВЫЕ ПРЕДОХРАНИТЕЛИ  (важно!)
#    DEFAULT_MODE:
#      safe — только рекомендации, ни одной покупки  <- начните с этого
#      semi — покупка после вашего подтверждения в боте
#      auto — автономно; только площадки из AUTO_WHITELIST
#    KILL_SWITCH=true мгновенно запрещает любые торговые операции.
#    MAX_TRADE_STARS=0 означает «без предела» — задайте реальное число
#    перед первым включением semi/auto.
#    AUTO_WHITELIST: допускается только telegram (официальный API).
# ---------------------------------------------------------------------
DEFAULT_MODE=safe
KILL_SWITCH=false

# --- Боевой режим площадок ------------------------------------------
# Проще включать в панели: раздел «Торговля». Значения ниже —
# начальные, панель их перекрывает.
#
# Ни одна площадка не торгует, пока не включена явно.
TELEGRAM_ENABLE_WRITE=false

# Portals и MRKT: у них нет публичного API и обязательств по
# доступности. Эндпоинты могут поменяться без предупреждения, а
# аккаунт — быть заблокирован. Риск ваш.
# Проверить готовность: gift-cli contract portals
PORTALS_ENABLE_WRITE=false
PORTALS_MAX_TRADE_TON=0

MRKT_ENABLE_WRITE=false
MRKT_MAX_TRADE_TON=0

# Пустить площадки без SLA в автономный режим (без подтверждения
# каждой сделки). Включайте только после успешной ручной торговли.
ALLOW_EXPERIMENTAL_AUTO=false

# AUTO_WHITELIST больше не используется: автономная торговля идёт по
# тем площадкам, у которых включён боевой режим.
MAX_TRADE_STARS=5000
DAILY_LIMIT_STARS=20000
MAX_OPEN_POSITIONS=10
MIN_ROI=0.15
RESERVATION_TTL_SEC=180
AUTO_WHITELIST=

# ---------------------------------------------------------------------
# 7. ХРАНИЛИЩЕ
# ---------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://gift:CHANGE_ME@127.0.0.1:5432/gift
DATA_DIR=/var/lib/gift
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# 8. ВЕБ-ПАНЕЛЬ
#    Пустой WEB_PASSWORD отключает панель.
# ---------------------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_USER=admin
WEB_PASSWORD=
PUBLIC_URL=

# ---------------------------------------------------------------------
# 9. ИНТЕРВАЛЫ ВОРКЕРОВ, секунды
#    Не ставьте SCAN_INTERVAL_SEC ниже 30: Telegram выдаст FloodWait.
# ---------------------------------------------------------------------
SCAN_INTERVAL_SEC=60
REPRICE_INTERVAL_SEC=300
RECONCILE_INTERVAL_SEC=120
